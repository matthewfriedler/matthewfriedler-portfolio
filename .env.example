# Copy to .env for local testing (node dev-server.js). Never commit .env.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Leave unset to use Resend's test sender (onboarding@resend.dev),
# which only delivers to the email on your Resend account. Set to an address
# on a domain you've verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
CONTACT_FROM=
